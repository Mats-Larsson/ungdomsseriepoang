<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings for coverlet. Used by coverage.ps1 and the GitHub build workflow. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Test projects and shared test data are not production code -->
          <Exclude>[TestData]*,[*Tests]*,[*Test]*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
